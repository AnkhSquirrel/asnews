# Copy to deploy/.env and fill in. deploy/.env is git-ignored.
# Keep comments on their own lines.

# Used inside DATABASE_URL, so keep it URL-safe. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Creates the admin on first start. feedctl also logs in with these: if you change the
# password in the Miniflux UI, change it here too.
MINIFLUX_ADMIN_USERNAME=admin
MINIFLUX_ADMIN_PASSWORD=

# Public URL served by network-core's nginx (hostname resolved by its dnsmasq), with trailing slash.
# Must match server_name in nginx-asnews.conf.example (https: nginx terminates TLS). Example: https://asnews.lan/
MINIFLUX_BASE_URL=

MINIFLUX_POLLING_FREQUENCY=30
MINIFLUX_VERSION=2.3.3

# --- feedctl (one-shot service, runs `apply` on every `up`) ---
# The first live apply is a dry run: read `docker compose logs feedctl`, then empty this
# and run `docker compose up -d --force-recreate feedctl`.
FEEDCTL_APPLY_FLAGS=-dry-run
# Image with the rules and feed list, published by CI from main. Override for a fork or a local build.
# FEEDCTL_IMAGE=ghcr.io/ankhsquirrel/asnews-feedctl:latest
# Optional API key (Miniflux > Settings > API Keys); used instead of the admin password if set.
# MINIFLUX_TOKEN=
